# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Auth, Postgres, Storage) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model for discovery, evaluation and findings (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Optional: model for the per-step browser agent (defaults to ANTHROPIC_MODEL)
ANTHROPIC_AGENT_MODEL=
# Server-side refusal fallbacks are on by default for supported models; set "off" to disable
ANTHROPIC_FALLBACKS=off

# --- Resend ---------------------------------------------------------------
# Auth emails are sent by Supabase through Resend SMTP (configure in Supabase).
# Only needed if the app itself sends email through the Resend API.
RESEND_API_KEY=

# --- Daytona (isolated browser sandboxes) ---------------------------------
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# Must match the installed playwright-core version
PLAYWRIGHT_VERSION=1.64.1

# --- Background jobs ------------------------------------------------------
# worker  = leave jobs queued in the DB for scripts/worker.ts (Railway/EC2)
# trigger = run on Trigger.dev. Unset: Trigger.dev if TRIGGER_SECRET_KEY is set,
#           otherwise in-process (local dev only).
JOB_RUNNER=
# Worker only: personas run at once per test (~500 MB RAM each)
PERSONA_CONCURRENCY=1

# --- Trigger.dev (optional background job host) ---------------------------
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# --- Development only -------------------------------------------------------
# Run Chromium locally instead of Daytona (ignored in production)
ALLOW_LOCAL_BROWSER=false
# Optional: force the browser backend (daytona | local). Default: Daytona if
# DAYTONA_API_KEY is set, otherwise local Chromium inside deployed Trigger.dev workers.
# BROWSER_PROVIDER=

# --- Billing (Startup plan, £99/month) ------------------------------------
# Stripe: secret key, the recurring Price id, and the webhook signing secret
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# PayPal: REST app credentials; plan id from `node --env-file=.env.local scripts/paypal-setup.mjs`
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
