# Job worker image (Railway / EC2 / any container host).
# The Playwright base image ships Chromium + system deps matching playwright-core 1.64.1.
FROM mcr.microsoft.com/playwright:v1.64.1-noble

WORKDIR /app
# Pinned to package.json "packageManager" (corepack is not bundled with newer Node).
RUN npm install -g pnpm@10.30.3

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json ./
COPY src ./src
COPY scripts/worker.ts ./scripts/worker.ts

# Sized for a Railway Hobby service with ~4 vCPU / 8 GB: 3 personas in parallel per test
# (one Chromium per test, ~0.5 GB per persona) and up to 2 tests at once.
# Service variables in Railway override these.
ENV NODE_ENV=production \
    BROWSER_PROVIDER=local \
    PERSONA_CONCURRENCY=3 \
    WORKER_MAX_TESTS=2

# Run as the image's unprivileged user (Chromium sandbox works without root).
RUN chown -R pwuser:pwuser /app
USER pwuser

CMD ["pnpm", "worker"]
